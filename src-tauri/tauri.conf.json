{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Viewer",
  "version": "0.2.0",
  "identifier": "io.github.akaneghro.mdviewer",
  "build": {
    "beforeDevCommand": "pnpm nuxt:dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MD Viewer",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 300,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Alberto Alonso",
    "copyright": "© 2026 Alberto Alonso",
    "license": "MIT",
    "homepage": "https://github.com/akaneghro/md-viewer",
    "category": "Productivity",
    "shortDescription": "A fast, minimal Markdown viewer and editor",
    "longDescription": "MD Viewer is a lightweight desktop app to read and edit Markdown documents, with GitHub Flavored Markdown, syntax highlighting, a table of contents, dark mode and safe rendering.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "resources": {
      "icons/markdown.ico": "resources/markdown.ico"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "MDViewer.Markdown",
        "mimeType": "text/markdown",
        "description": "Markdown Document",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
